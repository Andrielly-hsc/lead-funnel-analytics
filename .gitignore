# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.eggs/

# --- Virtual environments ---
.venv/
venv/

# --- Testing / tooling caches ---
.pytest_cache/
.coverage
coverage.xml
htmlcov/
.ruff_cache/
.mypy_cache/

# --- Notebooks ---
.ipynb_checkpoints/

# --- Environment & secrets (never commit) ---
.env
.env.*
!.env.example

# --- Generated data (reproducible from code) ---
# Leading slash = only the top-level folder; a bare "data/" would also hide docs/data/.
/data/
*.duckdb
*.duckdb.wal

# --- dbt ---
dbt/target/
dbt/logs/
dbt/dbt_packages/
dbt/.user.yml
logs/

# --- OS / editors ---
.DS_Store
Thumbs.db
.vscode/
.idea/
