# Copy to `.env` and adjust. `.env` is git-ignored; this file documents every setting.
# Real environment variables always win over values in `.env`.

# Root folder for generated data (landing zone, quarantine, warehouse).
LF_DATA_DIR=data

# DuckDB warehouse file. Default: <LF_DATA_DIR>/warehouse/lead_funnel.duckdb
# LF_DB_PATH=data/warehouse/lead_funnel.duckdb

# Folder for generated reports (quality profiles, scorecard, figures).
LF_REPORTS_DIR=reports

# Random seed for the synthetic data generator (reproducibility).
LF_SEED=42

# First-response SLA in minutes (a lead is "SLA met" if answered within this time).
LF_SLA_MINUTES=60

# DEBUG, INFO, WARNING, ERROR or CRITICAL
LF_LOG_LEVEL=INFO
